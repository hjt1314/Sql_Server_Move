<Window x:Class="SqlServerMigration.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SqlServerMigration.App.Models"
        mc:Ignorable="d"
        Title="SQL Server 2025 → 2019 数据迁移"
        Width="1280" Height="700" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
        </Style>
        <Style x:Key="ModeCardStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Padding="10,8" Background="#F8FAFC"
                                BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#60A5FA" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="SQL Server 2025 → 2019 数据迁移" />
                    <TextBlock Margin="0,3,0,0" Foreground="#64748B" FontSize="12"
                               Text="同机实例 · 从静态备份还原库迁移到 SQL Server 2019 企业版" />
                </StackPanel>
                <Border Grid.Column="1" MaxWidth="500" Padding="13,8" CornerRadius="6"
                        Background="{Binding StatusBannerBackground}">
                    <TextBlock Foreground="{Binding StatusBannerForeground}" Text="{Binding StatusBannerText}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14">
                <Border Style="{StaticResource CardStyle}" Padding="10">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,0" Padding="9,6" CornerRadius="6" Background="{Binding StatusBackground}"
                                        BorderBrush="{Binding StatusColor}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusColor}" Text="{Binding StatusGlyph}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding Title}" />
                                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{Binding StatusColor}" Text="{Binding StatusText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}" IsEnabled="{Binding CanEditConnections}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Text="连接信息" />
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="服务器主机（同一台机器）" />
                                <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" ToolTip="localhost、机器名或内网 IP" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Margin="14,18,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{Binding InputGuidanceColor}" Text="{Binding InputGuidanceText}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="12,9" Background="#F8FAFC" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="#1D4ED8" Text="源端 · SQL Server 2025 备份还原库" />
                                    <UniformGrid Margin="0,8,0,0" Columns="2">
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="实例名（默认实例可留空）" />
                                            <TextBox Text="{Binding SourceInstanceName, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 SQL2025" />
                                        </StackPanel>
                                        <StackPanel Margin="5,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="数据库名" />
                                            <TextBox Text="{Binding SourceDatabaseName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="认证方式" />
                                            <ComboBox ItemsSource="{Binding AuthenticationOptions}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding SourceAuthenticationMode}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="登录名" />
                                            <TextBox IsEnabled="{Binding IsSourceSqlAuthentication}" Text="{Binding SourceUserName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="密码（不保存）" />
                                            <PasswordBox x:Name="SourcePasswordBox" Tag="Source" IsEnabled="{Binding IsSourceSqlAuthentication}"
                                                         PasswordChanged="PasswordBox_OnPasswordChanged" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="12,9" Background="#F8FAFC" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="#15803D" Text="目标端 · SQL Server 2019 企业版" />
                                    <UniformGrid Margin="0,8,0,0" Columns="2">
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="实例名（默认实例可留空）" />
                                            <TextBox Text="{Binding TargetInstanceName, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 SQL2019" />
                                        </StackPanel>
                                        <StackPanel Margin="5,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="新目标数据库名" />
                                            <TextBox Text="{Binding TargetDatabaseName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="认证方式" />
                                            <ComboBox ItemsSource="{Binding AuthenticationOptions}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding TargetAuthenticationMode}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="登录名" />
                                            <TextBox IsEnabled="{Binding IsTargetSqlAuthentication}" Text="{Binding TargetUserName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="密码（不保存）" />
                                            <PasswordBox x:Name="TargetPasswordBox" Tag="Target" IsEnabled="{Binding IsTargetSqlAuthentication}"
                                                         PasswordChanged="PasswordBox_OnPasswordChanged" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding IsStaticSourceConfirmed, Mode=TwoWay}"
                                  Foreground="#9A3412"
                                  FontWeight="SemiBold"
                                  Content="我确认源数据库来自备份还原，迁移期间不会再写入（必须确认后才能预检和迁移）" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="性能模式" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{Binding ModeStatusColor}" FontSize="12"
                                           FontWeight="SemiBold" Text="{Binding ModeStatusText}" />
                            </Grid>
                            <UniformGrid Margin="0,9,0,0" Columns="3">
                                <RadioButton GroupName="PerformanceMode" Style="{StaticResource ModeCardStyle}"
                                             IsChecked="{Binding IsHighSpeedSelected, Mode=OneWay}" Command="{Binding SelectPerformanceModeCommand}"
                                             CommandParameter="{x:Static models:MigrationPerformanceMode.HighSpeed}">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="高速" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#64748B" Text="2 表 · 50,000 行/批" /><TextBlock FontSize="11" Foreground="#64748B" Text="CPU 92% 暂停" /></StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PerformanceMode" Style="{StaticResource ModeCardStyle}"
                                             IsChecked="{Binding IsBalancedSelected, Mode=OneWay}" Command="{Binding SelectPerformanceModeCommand}"
                                             CommandParameter="{x:Static models:MigrationPerformanceMode.Balanced}">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="平衡" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#64748B" Text="1 表 · 25,000 行/批" /><TextBlock FontSize="11" Foreground="#64748B" Text="CPU 82% 暂停" /></StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PerformanceMode" Margin="0" Style="{StaticResource ModeCardStyle}"
                                             IsChecked="{Binding IsLowImpactSelected, Mode=OneWay}" Command="{Binding SelectPerformanceModeCommand}"
                                             CommandParameter="{x:Static models:MigrationPerformanceMode.LowImpact}">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="低影响（默认）" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#64748B" Text="1 表 · 10,000 行/批" /><TextBlock FontSize="11" Foreground="#64748B" Text="CPU 72% 暂停" /></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid><TextBlock Style="{StaticResource SectionTitleStyle}" Text="实时状态" /><TextBlock HorizontalAlignment="Right" MaxWidth="250" Foreground="#64748B" Text="{Binding CurrentObjectText}" TextTrimming="CharacterEllipsis" /></Grid>
                            <UniformGrid Margin="0,9,0,0" Columns="4">
                                <StackPanel><TextBlock FontSize="11" Foreground="#64748B" Text="CPU" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CpuUsageText}" /></StackPanel>
                                <StackPanel><TextBlock FontSize="11" Foreground="#64748B" Text="处理速度" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding RowsPerSecondText}" /></StackPanel>
                                <StackPanel><TextBlock FontSize="11" Foreground="#64748B" Text="预计剩余" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding EstimatedRemainingText}" /></StackPanel>
                                <StackPanel><TextBlock FontSize="11" Foreground="#64748B" Text="已迁移行" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding RowsText}" /></StackPanel>
                            </UniformGrid>
                            <Grid Margin="0,9,0,0">
                                <ProgressBar Height="8" Maximum="100" Value="{Binding OverallProgressPercent}" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="#475569" Text="{Binding ProgressText}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}" Padding="13,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="76" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日志摘要" />
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" Text="{Binding TimeText}" />
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LevelColor}" Text="{Binding LevelText}" />
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="#334155" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" Text="暂无日志；完成连接信息后从“测试连接”开始。">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasLogs}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="#475569" FontSize="12" Text="默认低影响模式；运行中切换会在下一批生效。" />
                    <TextBlock Foreground="#94A3B8" FontSize="11" Text="不会自动连接、覆盖数据库或保存密码；开始按钮仅在连接与预检成功后可用。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding TestConnectionsCommand}" Content="测试连接" />
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding RunPreflightCommand}" Content="执行预检" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartMigrationCommand}" Content="开始迁移" />
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding PauseResumeCommand}" Content="{Binding PauseButtonText}" />
                    <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" Content="取消" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
